	<string>Face ID unlocks the vault. The device passcode is the fallback.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>The microphone records audio for videos captured into the vault.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
